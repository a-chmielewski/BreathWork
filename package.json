{
  "name": "breathwork",
  "private": true,
  "scripts": {
    "test": "node --test tests/unit/*.test.js",
    "pretest:browser": "playwright install webkit",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run test:browser",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:all",
    "postinstall": "playwright install webkit",
    "icons": "python scripts/generate-icons.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
